load("//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_lit_test_suite(
    name = "lit",
    srcs = ["annotate.mlir"],
    cfg = "//samples:lit.cfg.py",
    data = ["//samples/compiler_plugins/out_of_tree_example:iree_compiler_plugin_ootex"],
    env = {
        "IREE_OOTEX_PLUGIN": "$(rootpath //samples/compiler_plugins/out_of_tree_example:iree_compiler_plugin_ootex)",
    },
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = [
        "//tools:iree-compile",
        "@llvm-project//llvm:FileCheck",
    ],
)
