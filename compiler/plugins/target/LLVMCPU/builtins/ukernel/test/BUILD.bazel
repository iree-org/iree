load("//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_lit_test_suite(
    name = "lit",
    srcs = enforce_glob(
        # keep sorted
        [
            "e2e_inner_tiled_pipeline.mlir",
            "lookup_builtin_and_byo.mlir",
            "lower_inner_tiled_to_bitcode_ukernel.mlir",
            "lower_inner_tiled_to_bitcode_ukernel_i8_vnni.mlir",
            "select_ukernel.mlir",
            "ukernel_inlining.mlir",
        ],
        include = ["*.mlir"],
        exclude = [
            "ukernel_inlining_aarch64.mlir",
            "ukernel_inlining_riscv64.mlir",
        ],
    ),
    cfg = "//compiler:lit.cfg.py",
    tools = [
        "//tools:iree-compile",
        "//tools:iree-opt",
        "@llvm-project//llvm:FileCheck",
    ],
)

# Tests that need an LLVM target other than X86. The tags let builds whose LLVM
# lacks the target exclude them, like build_and_test_byo_llvm.sh does.

iree_lit_test_suite(
    name = "lit_aarch64",
    srcs = ["ukernel_inlining_aarch64.mlir"],
    cfg = "//compiler:lit.cfg.py",
    tags = ["requires-llvm-target-aarch64"],
    tools = [
        "//tools:iree-compile",
        "@llvm-project//llvm:FileCheck",
    ],
)

iree_lit_test_suite(
    name = "lit_riscv64",
    srcs = ["ukernel_inlining_riscv64.mlir"],
    cfg = "//compiler:lit.cfg.py",
    tags = ["requires-llvm-target-riscv"],
    tools = [
        "//tools:iree-compile",
        "@llvm-project//llvm:FileCheck",
    ],
)
