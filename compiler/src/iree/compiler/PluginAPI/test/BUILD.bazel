load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")
load("//build_tools/bazel:renamed_link.bzl", "iree_compiler_register_dynamic_plugin")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Built here so the tests need no compiler of their own. Plain C and not
# renamed: their callbacks do not reference compiler C++ symbols.
[
    cc_binary(
        name = plugin,
        testonly = True,
        srcs = ["plugins/%s.c" % plugin],
        linkshared = True,
    )
    for plugin in [
        "invalid_plugin",
        "version_mismatch_plugin",
    ]
]

[
    cc_binary(
        name = plugin,
        testonly = True,
        srcs = ["plugins/%s.c" % plugin],
        linkshared = True,
        deps = ["//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint"],
    )
    for plugin in [
        "valid_plugin",
        "abi_hash_mismatch_plugin",
        "null_field_plugin",
        "duplicate_id_plugin",
        "registration_failure_plugin",
    ]
]

cc_test(
    name = "embedding_registration_test",
    srcs = ["embedding_registration_test.c"],
    args = [
        "$(location //lib:IREECompiler)",
        "$(location :registration_failure_plugin)",
    ],
    data = [
        ":registration_failure_plugin",
        "//lib:IREECompiler",
    ],
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//compiler/bindings/c:headers",
        "//compiler/bindings/c:loader",
    ],
)

cc_binary(
    name = "static_collision_plugin",
    testonly = True,
    srcs = ["plugins/static_collision_plugin.c"],
    linkshared = True,
    deps = [
        "//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint",
        "//compiler/src/iree/compiler/PluginAPI/Config:StaticLinkedPlugins",
    ],
)

cc_test(
    name = "embedding_static_collision_test",
    srcs = ["embedding_registration_test.c"],
    args = [
        "$(location //lib:IREECompiler)",
        "$(location :static_collision_plugin)",
    ],
    data = [
        ":static_collision_plugin",
        "//lib:IREECompiler",
    ],
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//compiler/bindings/c:headers",
        "//compiler/bindings/c:loader",
    ],
)

cc_binary(
    name = "undefined_symbol_plugin",
    testonly = True,
    srcs = ["plugins/undefined_symbol_plugin.c"],
    linkopts = select({
        # ELF leaves undefined symbols alone; ld64 has to be told.
        "@platforms//os:macos": ["-Wl,-undefined,dynamic_lookup"],
        "//conditions:default": [],
    }),
    linkshared = True,
    deps = ["//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint"],
)

# Out-of-tree plugins are normally built with hidden visibility; the macro must
# export the entry point itself.
cc_binary(
    name = "hidden_visibility_plugin",
    testonly = True,
    srcs = ["plugins/hidden_visibility_plugin.cpp"],
    copts = ["-fvisibility=hidden"],
    linkshared = True,
    deps = ["//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint"],
)

# Two libraries, as any real plugin. Neither is in the compiler, so the plugin
# link carries them.
cc_library(
    name = "deps_helper",
    srcs = ["plugins/deps_helper.cpp"],
    hdrs = ["plugins/deps_helper.h"],
)

cc_library(
    name = "deps_plugin",
    srcs = ["plugins/deps_plugin.cpp"],
    deps = [
        ":deps_helper",
        "//compiler/src/iree/compiler/PluginAPI",
        "//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint",
    ],
)

iree_compiler_register_dynamic_plugin(
    compiler = "//lib:IREECompilerShared",
    plugin_id = "deps_plugin",
    target = ":deps_plugin",
)

cc_library(
    name = "dynamic_plugin",
    srcs = ["dynamic_plugin.cpp"],
    deps = [
        "//compiler/src/iree/compiler/PluginAPI",
        "//compiler/src/iree/compiler/PluginAPI:PluginEntryPoint",
        "@llvm-project//mlir:IR",
    ],
)

iree_compiler_register_dynamic_plugin(
    compiler = "//lib:IREECompilerShared",
    plugin_id = "dynamic_test_plugin",
    target = ":dynamic_plugin",
)

iree_lit_test_suite(
    name = "lit",
    srcs = enforce_glob(
        [
            "abi_hash_mismatch.txt",
            "duplicate_id.txt",
            "dynamic_plugin.txt",
            "invalid_options.txt",
            "invalid_plugin.txt",
            "plugin_with_deps.txt",
            "hidden_visibility.txt",
            "null_field.txt",
            "undefined_symbol.txt",
            "valid_plugin.txt",
            "version_mismatch.txt",
        ],
        include = ["*.txt"],
    ),
    cfg = "//compiler:lit.cfg.py",
    data = [
        ":abi_hash_mismatch_plugin",
        ":duplicate_id_plugin",
        ":hidden_visibility_plugin",
        ":invalid_plugin",
        ":iree_compiler_plugin_deps_plugin",
        ":iree_compiler_plugin_dynamic_test_plugin",
        ":null_field_plugin",
        ":undefined_symbol_plugin",
        ":valid_plugin",
        ":version_mismatch_plugin",
    ],
    env = {
        "IREE_TEST_ABI_HASH_MISMATCH_PLUGIN": "$(rootpath :abi_hash_mismatch_plugin)",
        "IREE_TEST_VALID_PLUGIN": "$(rootpath :valid_plugin)",
        "IREE_TEST_INVALID_PLUGIN": "$(rootpath :invalid_plugin)",
        "IREE_TEST_VERSION_MISMATCH_PLUGIN": "$(rootpath :version_mismatch_plugin)",
        "IREE_TEST_HIDDEN_VISIBILITY_PLUGIN": "$(rootpath :hidden_visibility_plugin)",
        "IREE_TEST_UNDEFINED_SYMBOL_PLUGIN": "$(rootpath :undefined_symbol_plugin)",
        "IREE_TEST_NULL_FIELD_PLUGIN": "$(rootpath :null_field_plugin)",
        "IREE_TEST_DUPLICATE_ID_PLUGIN": "$(rootpath :duplicate_id_plugin)",
        "IREE_TEST_DEPS_PLUGIN": "$(rootpath :iree_compiler_plugin_deps_plugin)",
        "IREE_TEST_DYNAMIC_PLUGIN": "$(rootpath :iree_compiler_plugin_dynamic_test_plugin)",
    },
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//os:macos"],
        "@platforms//os:linux": ["@platforms//os:linux"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = [
        "//tools:iree-compile",
        "//tools:iree-opt",
        "@llvm-project//llvm:FileCheck",
    ],
)
