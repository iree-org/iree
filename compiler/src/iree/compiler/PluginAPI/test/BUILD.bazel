load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Built rather than compiled inside a RUN line, so the tests need no compiler of
# their own. Plain C, and deliberately not renamed: they are never registered.
[
    cc_binary(
        name = plugin,
        testonly = True,
        srcs = ["plugins/%s.c" % plugin],
        linkshared = True,
    )
    for plugin in [
        "valid_plugin",
        "invalid_plugin",
        "version_mismatch_plugin",
    ]
]

# Hidden visibility is what an out-of-tree plugin is normally built with, so
# the macro must export the entry point without help.
cc_binary(
    name = "hidden_visibility_plugin",
    testonly = True,
    srcs = ["plugins/hidden_visibility_plugin.cpp"],
    copts = ["-fvisibility=hidden"],
    linkshared = True,
    deps = ["//compiler/src/iree/compiler/PluginAPI"],
)

iree_lit_test_suite(
    name = "lit",
    srcs = enforce_glob(
        [
            "invalid_options.txt",
            "invalid_plugin.txt",
            "hidden_visibility.txt",
            "valid_plugin.txt",
            "version_mismatch.txt",
        ],
        include = ["*.txt"],
    ),
    cfg = "//compiler:lit.cfg.py",
    data = [
        ":hidden_visibility_plugin",
        ":invalid_plugin",
        ":valid_plugin",
        ":version_mismatch_plugin",
    ],
    env = {
        "IREE_TEST_VALID_PLUGIN": "$(rootpath :valid_plugin)",
        "IREE_TEST_INVALID_PLUGIN": "$(rootpath :invalid_plugin)",
        "IREE_TEST_VERSION_MISMATCH_PLUGIN": "$(rootpath :version_mismatch_plugin)",
        "IREE_TEST_HIDDEN_VISIBILITY_PLUGIN": "$(rootpath :hidden_visibility_plugin)",
    },
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//os:macos"],
        "@platforms//os:linux": ["@platforms//os:linux"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = [
        "//tools:iree-compile",
        "//tools:iree-opt",
        "@llvm-project//llvm:FileCheck",
    ],
)
