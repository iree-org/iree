load("//build_tools/bazel:build_defs.oss.bzl", "iree_runtime_cc_library")
load("//build_tools/bazel:iree_hal_external_driver.bzl", "iree_hal_external_driver")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "registration",
    srcs = ["driver_module.c"],
    hdrs = ["driver_module.h"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
    deps = [
        "//experimental/runtime/src:runtime_defines",
        "//experimental/runtime/src/iree/hal/drivers/hexagon",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

# Enables the driver in the tools with:
#   --//runtime/src/iree/hal/drivers:external_drivers=//experimental/runtime/src/iree/hal/drivers/hexagon/registration:driver
# (see --config=hexagon). CMake registers the driver in the root CMakeLists.txt.
iree_hal_external_driver(
    name = "driver",
    register_fns = ["iree_hal_hexagon_driver_module_register"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
    deps = [":registration"],
)
