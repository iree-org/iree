load("//build_tools/bazel:build_defs.oss.bzl", "iree_runtime_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Experimental Qualcomm Hexagon DSP HAL driver. Runs on Android aarch64 hosts.
iree_runtime_cc_library(
    name = "hexagon",
    srcs = [
        "allocator.c",
        "allocator.h",
        "device.c",
        "device.h",
        "driver.c",
        "driver.h",
        "rpc_types.c",
        "rpc_types.h",
        "utils.c",
        "utils.h",
    ],
    hdrs = [
        "api.h",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
    deps = [
        "//experimental/runtime/src:runtime_defines",
        "//experimental/runtime/src/iree/hal/drivers/hexagon/interface:hexagon_dsp",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "@hexagon_sdk//:fastrpc_headers",
    ],
)
