load("//build_tools/bazel:iree_hexagon_dsp_library.bzl", "iree_hexagon_dsp_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Device library loaded on the DSP when a Hexagon device is created. Deploy as
# <bin>/../lib/hexagon/libhexagon_dsp_skel.so next to the tools.
iree_hexagon_dsp_library(
    name = "hexagon_dsp_skel",
    srcs = ["device.c"],
    arch = "v79",
    interface = "//experimental/runtime/src/iree/hal/drivers/hexagon/interface:hexagon_dsp",
)
