load("//build_tools/bazel:iree_check_test.bzl", "iree_check_single_backend_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_check_single_backend_test_suite(
    name = "check_llvm-cpu_local-task",
    srcs = [
        "contraction_scaling.mlir",
    ],
    compiler_flags = [
        "--iree-llvmcpu-target-cpu=generic",
        # Match before unit-dimension folding inserts reshapes between the
        # convolution and its dequantized operands.
        "--iree-preprocessing-pass-pipeline=builtin.module\\(util.func\\(iree-global-opt-convert-qdq-to-integer-math\\)\\)",
    ],
    driver = "local-task",
    target_backend = "llvm-cpu",
)

iree_check_single_backend_test_suite(
    name = "check_reference_llvm-cpu_local-task",
    srcs = [
        "contraction_scaling.mlir",
    ],
    compiler_flags = [
        "--iree-global-opt-enable-qdq-to-integer-math=false",
        "--iree-llvmcpu-target-cpu=generic",
    ],
    driver = "local-task",
    target_backend = "llvm-cpu",
)
