// Convolutions whose strided window leaves the last input column unread, with
// input or kernel dilation, padding and feature groups.

func.func @conv_lhs_dilation_stride() {
  %x = util.unfoldable_constant dense<[[[[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]], [[-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0]], [[3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0]], [[-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0]], [[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]]]]> : tensor<2x5x3x4xf32>
  %w = util.unfoldable_constant dense<[[[[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0]], [[2.0, -2.0, -1.0, 0.0, 1.0, 2.0], [-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, -2.0, -1.0, 0.0, 1.0], [2.0, -2.0, -1.0, 0.0, 1.0, 2.0], [-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0], [2.0, -2.0, -1.0, 0.0, 1.0, 2.0], [-2.0, -1.0, 0.0, 1.0, 2.0, -2.0]]], [[[-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0], [2.0, -2.0, -1.0, 0.0, 1.0, 2.0]], [[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0]]]]> : tensor<3x2x4x6xf32>
  %r = stablehlo.convolution(%x, %w) dim_numbers = [b, 0, 1, f]x[0, 1, i, o]->[b, 0, 1, f], window = {stride = [1, 2], lhs_dilate = [2, 1]} {batch_group_count = 1 : i64, feature_group_count = 1 : i64} : (tensor<2x5x3x4xf32>, tensor<3x2x4x6xf32>) -> tensor<2x7x1x6xf32>
  check.expect_eq_const(%r, dense<[[[[-2.0, 2.0, 6.0, 5.0, -11.0, -2.0]], [[14.0, -4.0, -12.0, -5.0, 7.0, 14.0]], [[4.0, -4.0, -2.0, 5.0, -3.0, 4.0]], [[-9.0, -9.0, 1.0, 16.0, 1.0, -9.0]], [[-4.0, 4.0, -3.0, 5.0, -2.0, -4.0]], [[-4.0, 14.0, 7.0, -5.0, -12.0, -4.0]], [[2.0, -2.0, -11.0, 5.0, 6.0, 2.0]]], [[[-7.0, -7.0, 8.0, -2.0, 8.0, -7.0]], [[-10.0, -1.0, 18.0, 2.0, -9.0, -10.0]], [[13.0, -6.0, 0.0, -9.0, 2.0, 13.0]], [[9.0, 1.0, 3.0, -5.0, -8.0, 9.0]], [[-2.0, 2.0, 6.0, 5.0, -11.0, -2.0]], [[14.0, -4.0, -12.0, -5.0, 7.0, 14.0]], [[4.0, -4.0, -2.0, 5.0, -3.0, 4.0]]]]> : tensor<2x7x1x6xf32>) : tensor<2x7x1x6xf32>
  return
}

func.func @conv_lhs_dilation_stride_grouped() {
  %x = util.unfoldable_constant dense<[[[[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]], [[-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0]], [[3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0]], [[-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0]], [[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]]]]> : tensor<2x5x3x4xf32>
  %w = util.unfoldable_constant dense<[[[[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0]]], [[[2.0, -2.0, -1.0, 0.0, 1.0, 2.0], [-2.0, -1.0, 0.0, 1.0, 2.0, -2.0]], [[-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, -2.0, -1.0, 0.0, 1.0], [2.0, -2.0, -1.0, 0.0, 1.0, 2.0]], [[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0]]]]> : tensor<3x2x2x6xf32>
  %r = stablehlo.convolution(%x, %w) dim_numbers = [b, 0, 1, f]x[0, 1, i, o]->[b, 0, 1, f], window = {stride = [1, 2], lhs_dilate = [2, 1]} {batch_group_count = 1 : i64, feature_group_count = 2 : i64} : (tensor<2x5x3x4xf32>, tensor<3x2x2x6xf32>) -> tensor<2x7x1x6xf32>
  check.expect_eq_const(%r, dense<[[[[20.0, 7.0, -11.0, 4.0, -9.0, -12.0]], [[-1.0, -7.0, -3.0, -4.0, -11.0, -3.0]], [[3.0, -2.0, -2.0, -14.0, -2.0, 20.0]], [[1.0, -3.0, -7.0, 1.0, 10.0, -1.0]], [[-14.0, -11.0, 7.0, 3.0, -2.0, 3.0]], [[-4.0, 8.0, 10.0, -1.0, 10.0, 1.0]], [[4.0, 22.0, -5.0, 20.0, -2.0, -14.0]]], [[[-9.0, -10.0, -1.0, -9.0, 12.0, 8.0]], [[-5.0, -1.0, -2.0, 0.0, 10.0, 0.0]], [[-12.0, -5.0, 22.0, 8.0, 12.0, -9.0]], [[-3.0, 10.0, 8.0, 12.0, -4.0, -5.0]], [[20.0, 7.0, -11.0, 4.0, -9.0, -12.0]], [[-1.0, -7.0, -3.0, -4.0, -11.0, -3.0]], [[3.0, -2.0, -2.0, -14.0, -2.0, 20.0]]]]> : tensor<2x7x1x6xf32>) : tensor<2x7x1x6xf32>
  return
}

func.func @conv_rhs_dilation_padding_stride_grouped() {
  %x = util.unfoldable_constant dense<[[[[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]], [[-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0]], [[3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0], [2.0, 3.0, -3.0, -2.0]], [[-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0], [0.0, 1.0, 2.0, 3.0]], [[-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0], [-2.0, -1.0, 0.0, 1.0]], [[2.0, 3.0, -3.0, -2.0], [-1.0, 0.0, 1.0, 2.0], [3.0, -3.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, 3.0], [-3.0, -2.0, -1.0, 0.0], [1.0, 2.0, 3.0, -3.0]]]]> : tensor<2x5x3x4xf32>
  %w = util.unfoldable_constant dense<[[[[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0]], [[0.0, 1.0, 2.0, -2.0, -1.0, 0.0], [1.0, 2.0, -2.0, -1.0, 0.0, 1.0]]], [[[2.0, -2.0, -1.0, 0.0, 1.0, 2.0], [-2.0, -1.0, 0.0, 1.0, 2.0, -2.0]], [[-1.0, 0.0, 1.0, 2.0, -2.0, -1.0], [0.0, 1.0, 2.0, -2.0, -1.0, 0.0]]], [[[1.0, 2.0, -2.0, -1.0, 0.0, 1.0], [2.0, -2.0, -1.0, 0.0, 1.0, 2.0]], [[-2.0, -1.0, 0.0, 1.0, 2.0, -2.0], [-1.0, 0.0, 1.0, 2.0, -2.0, -1.0]]]]> : tensor<3x2x2x6xf32>
  %r = stablehlo.convolution(%x, %w) dim_numbers = [b, 0, 1, f]x[0, 1, i, o]->[b, 0, 1, f], window = {stride = [1, 2], pad = [[1, 2], [0, 1]], rhs_dilate = [1, 2]} {batch_group_count = 1 : i64, feature_group_count = 2 : i64} : (tensor<2x5x3x4xf32>, tensor<3x2x2x6xf32>) -> tensor<2x6x1x6xf32>
  check.expect_eq_const(%r, dense<[[[[5.0, 2.0, -11.0, -3.0, -6.0, -4.0]], [[0.0, -14.0, -8.0, -11.0, 11.0, 8.0]], [[-15.0, -5.0, 25.0, 18.0, 4.0, 0.0]], [[5.0, 25.0, -5.0, 5.0, -10.0, -15.0]], [[20.0, -4.0, -13.0, -5.0, -5.0, 0.0]], [[-5.0, -10.0, -5.0, -2.0, -1.0, 5.0]]], [[[-6.0, -3.0, 10.0, 2.0, 5.0, 13.0]], [[-5.0, 10.0, 10.0, 8.0, 11.0, -11.0]], [[8.0, 5.0, -13.0, -5.0, -10.0, -5.0]], [[0.0, -14.0, -8.0, -11.0, 11.0, 8.0]], [[-13.0, -4.0, 20.0, 13.0, 5.0, 2.0]], [[1.0, 5.0, -1.0, 5.0, -5.0, -10.0]]]]> : tensor<2x6x1x6xf32>) : tensor<2x6x1x6xf32>
