"""Repository rule detecting the Android NDK used for Android builds.

The NDK is located via the `ANDROID_NDK` environment variable (the same one
used by the CMake Android build), falling back to `ANDROID_NDK_HOME`.

The repository is always created. When no suitable NDK is found it is a stub
that records the reason in `ANDROID_NDK_ERROR`, so host builds never fail and
the error is only reported once something is actually built for Android (see
aarch64_android_toolchain_config.bzl).

The repository provides:
  - defs.bzl: Starlark constants describing the NDK.
  - :libcxx_shared: libc++_shared.so from the NDK sysroot, which has to be
    deployed next to binaries built with the NDK.
"""

# Supported NDK release (r28c is 28.2.13676358).
ANDROID_NDK_MAJOR_VERSION = "28"

# Android API level targeted by Bazel Android builds.
ANDROID_API_LEVEL = "28"

_NDK_ENV_VARS = ["ANDROID_NDK", "ANDROID_NDK_HOME"]

_LIBCXX_SHARED_REL_PATH = "sysroot/usr/lib/aarch64-linux-android/libc++_shared.so"

def _host_tag(repository_ctx):
    os_name = repository_ctx.os.name.lower()
    if os_name.startswith("linux"):
        return "linux-x86_64"
    if os_name.startswith("mac os"):
        return "darwin-x86_64"
    return None

def _find_ndk(repository_ctx):
    """Returns (ndk_dir, error) for the NDK configured in the environment."""
    ndk_dir = None
    for env_var in _NDK_ENV_VARS:
        value = repository_ctx.getenv(env_var)
        if value:
            ndk_dir = value
            break
    if not ndk_dir:
        return None, ("Android NDK not found: set ANDROID_NDK (or " +
                      "ANDROID_NDK_HOME) to an NDK r{} installation.").format(
            ANDROID_NDK_MAJOR_VERSION,
        )

    source_properties = repository_ctx.path(ndk_dir + "/source.properties")
    if not source_properties.exists:
        return None, "Android NDK at '{}' has no source.properties.".format(ndk_dir)
    revision = None
    for line in repository_ctx.read(source_properties).splitlines():
        key, _, value = line.partition("=")
        if key.strip() == "Pkg.Revision":
            revision = value.strip()
    if not revision or revision.split(".")[0] != ANDROID_NDK_MAJOR_VERSION:
        return None, ("Android NDK at '{}' has revision '{}' but Bazel " +
                      "Android builds require NDK r{}.").format(
            ndk_dir,
            revision,
            ANDROID_NDK_MAJOR_VERSION,
        )

    if not _host_tag(repository_ctx):
        return None, "Android NDK builds are not supported on host '{}'.".format(
            repository_ctx.os.name,
        )
    return ndk_dir, None

def _android_ndk_repo_impl(repository_ctx):
    ndk_dir, error = _find_ndk(repository_ctx)
    toolchain_dir = ""
    lib_clang_dir = ""
    libcxx_shared_srcs = []
    if ndk_dir:
        toolchain_dir = "{}/toolchains/llvm/prebuilt/{}".format(
            ndk_dir,
            _host_tag(repository_ctx),
        )

        # lib/clang/ contains exactly one directory named after the version of
        # the bundled clang.
        lib_clang_dir = str(repository_ctx.path(toolchain_dir + "/lib/clang").readdir()[0])
        repository_ctx.symlink(
            toolchain_dir + "/" + _LIBCXX_SHARED_REL_PATH,
            "libc++_shared.so",
        )
        libcxx_shared_srcs = ["libc++_shared.so"]

    repository_ctx.file("defs.bzl", content = """\
# AUTO-GENERATED by android_ndk_repo.bzl - do not edit.

ANDROID_NDK_AVAILABLE = {available}
ANDROID_NDK_ERROR = {error}
ANDROID_API_LEVEL = {api_level}
ANDROID_NDK_TOOLCHAIN_DIR = {toolchain_dir}
ANDROID_NDK_LIB_CLANG_DIR = {lib_clang_dir}
""".format(
        available = ndk_dir != None,
        error = repr(error or ""),
        api_level = repr(ANDROID_API_LEVEL),
        toolchain_dir = repr(toolchain_dir),
        lib_clang_dir = repr(lib_clang_dir),
    ))

    repository_ctx.file("BUILD.bazel", content = """\
# AUTO-GENERATED by android_ndk_repo.bzl - do not edit.

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

filegroup(
    name = "libcxx_shared",
    srcs = {libcxx_shared_srcs},
)
""".format(libcxx_shared_srcs = repr(libcxx_shared_srcs)))

android_ndk_repo = repository_rule(
    implementation = _android_ndk_repo_impl,
    environ = _NDK_ENV_VARS,
    local = True,
    doc = "Detects the Android NDK configured via ANDROID_NDK/ANDROID_NDK_HOME.",
)
