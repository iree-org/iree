"""Repository rule providing the Qualcomm Hexagon SDK.

Used by the experimental Hexagon HAL driver
(experimental/runtime/src/iree/hal/drivers/hexagon). The repository is only
fetched when a Hexagon target is built.

By default the free-to-download Hexagon SDK release is downloaded. An existing
SDK installation can be used instead with:
  --repo_env=HEXAGON_SDK_ROOT=/path/to/hexagon-sdk
"""

_HEXAGON_SDK_URL = "https://github.com/snapdragon-toolchain/hexagon-sdk/releases/download/v6.7.0.0/hexagon-sdk-v6.7.0.0-amd64-lnx.tar.xz"
_HEXAGON_SDK_SHA256 = "00725fc449916d7b9af2c2a3c6b54d61f3c872d5dbc1d3ca3fd2f839b1d5dc70"
_HEXAGON_SDK_STRIP_PREFIX = "6.7.0.0"

_HEXAGON_ARCH = "v79"

_BUILD_FILE = """\
# AUTO-GENERATED by hexagon_sdk_repo.bzl - do not edit.

load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# RPC interface compiler.
filegroup(
    name = "qaic",
    srcs = ["ipc/fastrpc/qaic/bin/qaic"],
)

# IDL files included by RPC interface definitions.
filegroup(
    name = "qaic_includes",
    srcs = glob([
        "incs/*.idl",
        "incs/stddef/*.idl",
    ]),
)

# FastRPC headers and client library for Android aarch64. The library itself
# is provided by the device at runtime.
cc_library(
    name = "fastrpc_headers",
    hdrs = glob([
        "incs/*.h",
        "incs/stddef/*.h",
        "ipc/fastrpc/rpcmem/inc/*.h",
    ]),
    includes = [
        "incs",
        "incs/stddef",
        "ipc/fastrpc/rpcmem/inc",
    ],
)

cc_import(
    name = "cdsprpc_android_aarch64_import",
    shared_library = "ipc/fastrpc/remote/ship/android_aarch64/libcdsprpc.so",
)

cc_library(
    name = "cdsprpc_android_aarch64",
    deps = [
        ":cdsprpc_android_aarch64_import",
        ":fastrpc_headers",
    ],
)

# Hexagon compiler driver used to build code running on the DSP.
filegroup(
    name = "hexagon_clang",
    srcs = ["{tools}/bin/hexagon-clang"],
)

# Files used by hexagon-clang when compiling and linking for the DSP.
filegroup(
    name = "hexagon_toolchain_files",
    srcs = glob([
        "{tools}/bin/clang*",
        "{tools}/bin/hexagon-clang",
        "{tools}/bin/hexagon-link",
        "{tools}/bin/ld.*",
        "{tools}/lib/*.so*",
        "{tools}/lib/clang/*/include/**",
        "{tools}/target/hexagon/include/**",
        "{tools}/target/hexagon/lib/{arch}/**",
    ]),
)

# Headers for code running on the DSP.
filegroup(
    name = "dsp_headers",
    srcs = glob([
        "incs/*.h",
        "incs/stddef/*.h",
        "rtos/qurt/compute{arch}/include/posix/**/*.h",
        "rtos/qurt/compute{arch}/include/qurt/**/*.h",
    ]),
)
"""

def _find_tools_dir(repository_ctx):
    """Returns the path of the Hexagon compiler toolchain in the SDK.

    The toolchain lives in tools/HEXAGON_Tools/<version>/Tools, where the
    version differs between SDK releases (e.g. 19.0.04 in 6.4.0.2 and 21.0.04
    in 6.7.0.0). Picks the newest version if there are several.
    Must be kept in sync with build_tools/cmake/iree_hexagon_sdk.cmake.
    """
    tools_root = repository_ctx.path("tools/HEXAGON_Tools")
    versions = [entry.basename for entry in tools_root.readdir()] if tools_root.exists else []
    if not versions:
        fail("No compiler toolchain found in tools/HEXAGON_Tools of the Hexagon SDK.")
    newest = sorted(
        versions,
        key = lambda version: [int(part) if part.isdigit() else 0 for part in version.split(".")],
    )[-1]
    return "tools/HEXAGON_Tools/{}/Tools".format(newest)

def _hexagon_sdk_repo_impl(repository_ctx):
    sdk_root = repository_ctx.getenv("HEXAGON_SDK_ROOT")
    if sdk_root:
        sdk_path = repository_ctx.path(sdk_root)
        if not sdk_path.exists:
            fail("HEXAGON_SDK_ROOT '{}' does not exist.".format(sdk_root))
        for entry in sdk_path.readdir():
            repository_ctx.symlink(entry, entry.basename)
    else:
        repository_ctx.download_and_extract(
            url = _HEXAGON_SDK_URL,
            sha256 = _HEXAGON_SDK_SHA256,
            stripPrefix = _HEXAGON_SDK_STRIP_PREFIX,
        )
    repository_ctx.file("BUILD.bazel", content = _BUILD_FILE.format(
        tools = _find_tools_dir(repository_ctx),
        arch = _HEXAGON_ARCH,
    ))

hexagon_sdk_repo = repository_rule(
    implementation = _hexagon_sdk_repo_impl,
    environ = ["HEXAGON_SDK_ROOT"],
    doc = "Downloads (or symlinks via HEXAGON_SDK_ROOT) the Hexagon SDK.",
)
