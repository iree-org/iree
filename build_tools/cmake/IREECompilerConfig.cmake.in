# This allows users to call find_package(IREECompiler) and access our targets.

include("${CMAKE_CURRENT_LIST_DIR}/IREETargets-Compiler.cmake")

# The prefix the compiler's llvm/mlir symbols were renamed with, and the script
# that reproduces it. Version and header hash come from the installed headers.
set(IREE_COMPILER_ABI_PREFIX "@IREE_COMPILER_ABI_PREFIX@")
set(IREE_COMPILER_RENAME_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/gen_rename_map.py")

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/IREECompilerPluginRules.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/IREECompilerPluginRules.cmake")
endif()

