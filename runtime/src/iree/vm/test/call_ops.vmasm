vm.export @test_call_v_ii
vm.func @test_call_v_ii() -> () {
^bb0:
  %i0 = vm.const.i32 9  // 0x00000009
  %i1 = vm.const.i32 1  // 0x00000001
  %i2 = vm.const.i32 2  // 0x00000002
  %i3, %i4 = vm.call @call_ops:15()
  %i1 = vm.cmp.ne.i32 %i3, %i1
  vm.cond_br %i1, ^bb4(), ^bb1()
^bb1:
  %i2 = vm.cmp.ne.i32 %i4, %i2
  vm.cond_br %i2, ^bb3(), ^bb2()
^bb2:
  vm.return
^bb3:
  vm.fail %i0, "_v_ii()#1=2"
^bb4:
  vm.fail %i0, "_v_ii()#0=1"
}

