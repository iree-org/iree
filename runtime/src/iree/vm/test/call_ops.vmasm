// Mixed-width values share the integer bank; references use a separate bank
// and must retain their ownership semantics.
vm.export @test_call_mixed_width_arguments_and_results
vm.func @test_call_mixed_width_arguments_and_results() -> () {
^bb0:
  %i0 = vm.const.i32 7
  %i2:3 = vm.const.i64 4294967298
  %r0 = vm.const.ref.rodata 0
  %i4 = vm.const.f32 3.5
  %i6:7 = vm.const.f64 5.5
  %i8 = vm.const.i32 11
  %i10 = vm.const.i32.zero
  %i12:13 = vm.const.i64.zero
  %i14 = vm.const.i32.zero
  %i16:17 = vm.const.i64.zero
  %i18 = vm.const.i32.zero
  %i10, %i12, %r1, %i14, %i16, %i18 = vm.call @call_ops:23(%i2, %i0, %r0, %i4, %i6, %i8)
  %i19 = vm.cmp.ne.i32 %i10, %i0
  %i20 = vm.cmp.ne.i64 %i12:13, %i2:3
  %i19 = vm.or.i32 %i19, %i20
  %i20 = vm.cmp.ne.f32.o %i14, %i4
  %i19 = vm.or.i32 %i19, %i20
  %i20 = vm.cmp.ne.f64.o %i16:17, %i6:7
  %i19 = vm.or.i32 %i19, %i20
  %i20 = vm.cmp.ne.i32 %i18, %i8
  %i19 = vm.or.i32 %i19, %i20
  %i20 = vm.cmp.ne.ref %r0, %r1
  %i19 = vm.or.i32 %i19, %i20
  vm.discard.refs %r0, %r1
  vm.cond_br %i19, ^bb2(), ^bb1()
^bb1:
  vm.return
^bb2:
  %i21 = vm.const.i32 9
  vm.fail %i21, "mixed-width call must preserve values and alignment"
}

vm.func @return_mixed_width(%i0:1: i64, %i2: i32, %r0: !vm.ref<?>, %i3: f32, %i4:5: f64, %i6: i32) -> (i32, i64, !vm.ref<?>, f32, f64, i32) {
^bb0:
  vm.return %i2, %i0, %R0, %i3, %i4, %i6
}
