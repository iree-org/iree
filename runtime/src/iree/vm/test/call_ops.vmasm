// Consecutive i64 arguments must each occupy two registers in the callee.
vm.export @test_call_consecutive_i64_arguments
vm.func @test_call_consecutive_i64_arguments() -> () {
^bb0:
  %i0:1 = vm.const.i64 4294967298
  %i2:3 = vm.const.i64 12884901892
  vm.call @call_ops:19(%i0, %i2)
  vm.return
}

vm.func @check_consecutive_i64(%i0:1: i64, %i2:3: i64) -> () {
^bb0:
  %i4:5 = vm.const.i64 4294967298
  %i6:7 = vm.const.i64 12884901892
  %i8 = vm.cmp.ne.i64 %i0:1, %i4:5
  %i9 = vm.cmp.ne.i64 %i2:3, %i6:7
  %i8 = vm.or.i32 %i8, %i9
  vm.cond_br %i8, ^bb2(), ^bb1()
^bb1:
  vm.return
^bb2:
  %i10 = vm.const.i32 9
  vm.fail %i10, "consecutive i64 arguments must preserve both words"
}

// Initialize destination high words so a partial return copy fails reliably.
vm.export @test_call_i64_results_preserve_high_words
vm.func @test_call_i64_results_preserve_high_words() -> () {
^bb0:
  %i0:1 = vm.const.i64.zero
  %i2:3 = vm.const.i64.zero
  %i0, %i2 = vm.call @call_ops:21()
  %i4:5 = vm.const.i64 4294967298
  %i6:7 = vm.const.i64 12884901892
  %i8 = vm.cmp.ne.i64 %i0:1, %i4:5
  %i9 = vm.cmp.ne.i64 %i2:3, %i6:7
  %i8 = vm.or.i32 %i8, %i9
  vm.cond_br %i8, ^bb2(), ^bb1()
^bb1:
  vm.return
^bb2:
  %i10 = vm.const.i32 9
  vm.fail %i10, "i64 results must preserve both words"
}

