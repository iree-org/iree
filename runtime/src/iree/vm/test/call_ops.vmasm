vm.export @test_call_r_v_preserve_ref
vm.func @test_call_r_v_preserve_ref() -> () {
^bb0:
  %i0 = vm.const.i32 9  // 0x00000009
  %i1 = vm.const.i32 1  // 0x00000001
  %r0 = vm.const.ref.zero
  %r1 = vm.const.ref.rodata 0  // 3b
  %i2 = vm.cmp.nz.ref %r1
  %i2 = vm.xor.i32 %i2, %i1
  vm.cond_br %i2, ^bb3(), ^bb1()
^bb1:
  vm.call @call_ops:12(%R0, %r1)
  %i2 = vm.cmp.nz.ref %r1
  vm.discard.refs %r1
  %i1 = vm.xor.i32 %i2, %i1
  vm.cond_br %i1, ^bb4(), ^bb2()
^bb2:
  vm.return
^bb3:
  vm.discard.refs %r0, %r1
  vm.br ^bb4()
^bb4:
  vm.fail %i0, ""
}

