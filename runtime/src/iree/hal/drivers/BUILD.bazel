load("@bazel_skylib//rules:common_settings.bzl", "string_list_flag")

# External HAL drivers. Modules that depend on IREE opt in by adding
# iree_extension.external_hal_driver tags to their MODULE.bazel. iree_extension
# collects them into @iree_external_hal_drivers (an empty list without tags).
# See build_tools/bazel/EXTERNAL_DRIVERS.md.
load("@iree_external_hal_drivers//:drivers.bzl", "get_external_hal_drivers")
load("//build_tools/bazel:build_defs.oss.bzl", "iree_runtime_cc_library")
load("//build_tools/bazel:hal_driver_init_gen.bzl", "iree_hal_driver_init_c_generator")
load("//build_tools/bazel:load_external_hal_drivers_utils.bzl", "get_register_fns", "get_targets")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

string_list_flag(
    name = "enabled_drivers",
    build_setting_default = [
        "amdgpu",
        "cuda",
        "hip",
        "local-sync",
        "local-task",
        "null",
        "vulkan",
    ],
)

_EXTERNAL_DRIVERS = get_external_hal_drivers()

_EXTERNAL_DRIVER_TARGETS = get_targets(_EXTERNAL_DRIVERS)

_EXTERNAL_DRIVER_REGISTER_FNS = get_register_fns(_EXTERNAL_DRIVERS)

iree_hal_driver_init_c_generator(
    name = "init_external_c",
    out = "init_external.c",
    registration_functions = _EXTERNAL_DRIVER_REGISTER_FNS,
    template = "init_external.c.in",
)

UNCONDITIONAL_DRIVERS = [
    "local-sync",
    "local-task",
    "null",
    "vulkan",
]

[
    config_setting(
        name = "{}_enabled".format(driver),
        flag_values = {
            ":enabled_drivers": driver,
        },
    )
    for driver in UNCONDITIONAL_DRIVERS
]

# AMDGPU is special and is conditioned on availability of ROCM.
config_setting(
    name = "amdgpu_enabled",
    flag_values = {
        ":enabled_drivers": "amdgpu",
    },
)

# CUDA is special and is conditioned on availability of the CUDA toolkit.
config_setting(
    name = "cuda_enabled",
    flag_values = {
        ":enabled_drivers": "cuda",
        "@iree_cuda//:enabled": "True",
    },
)

# HIP requires HIP API headers (from the hip-build-deps submodule).
config_setting(
    name = "hip_enabled",
    flag_values = {
        ":enabled_drivers": "hip",
    },
)

iree_runtime_cc_library(
    name = "drivers",
    srcs = ["init.c"] + (["init_external.c"] if _EXTERNAL_DRIVERS else []),
    hdrs = ["init.h"],
    local_defines = ["IREE_HAVE_HAL_EXTERNAL_DRIVERS=1"] if _EXTERNAL_DRIVERS else [],
    deps = [
               "//runtime/src/iree/base",
               "//runtime/src/iree/hal",
           ] + _EXTERNAL_DRIVER_TARGETS + select({
               ":amdgpu_enabled": ["//runtime/src/iree/hal/drivers/amdgpu/registration"],
               "//conditions:default": [],
           }) + select({
               ":cuda_enabled": ["//runtime/src/iree/hal/drivers/cuda/registration"],
               "//conditions:default": [],
           }) + select({
               ":hip_enabled": ["//runtime/src/iree/hal/drivers/hip/registration"],
               "//conditions:default": [],
           }) +
           select({
               ":local-sync_enabled": ["//runtime/src/iree/hal/drivers/local_sync/registration"],
               "//conditions:default": [],
           }) +
           select({
               ":local-task_enabled": ["//runtime/src/iree/hal/drivers/local_task/registration"],
               "//conditions:default": [],
           }) +
           select({
               ":null_enabled": ["//runtime/src/iree/hal/drivers/null/registration"],
               "//conditions:default": [],
           }) +
           select({
               ":vulkan_enabled": ["//runtime/src/iree/hal/drivers/vulkan/registration"],
               "//conditions:default": [],
           }),
)

exports_files(["init_external.c.in"])
