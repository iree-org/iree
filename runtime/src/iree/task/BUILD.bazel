        "testdata/sysfs/x86_dual_numa_sparse_clusters.tar.gz",
        "testdata/sysfs/x86_empty_cpulist_node.tar.gz",
        "testdata/sysfs/x86_hybrid_smt_sparse_clusters.tar.gz",
