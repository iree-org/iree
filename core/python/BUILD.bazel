load("@rules_python//python:defs.bzl", "py_library")
load("//build_tools/bazel:build_defs.oss.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("//build_tools/bazel:iree_py_test.bzl", "iree_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

# Also exported as files, for consumers that assemble the Python packages
# themselves.
PY_SRCS = enforce_glob(
    [
        "iree/core/__init__.py",
        "iree/core/_paths.py",
        "iree/core/config.py",
        "iree/core/log_config.py",
        "iree/core/plugins.py",
        "iree/core/result.py",
    ],
    include = ["iree/core/**/*.py"],
)

PY_TESTS = enforce_glob(
    [
        "test/config_test.py",
        "test/log_config_test.py",
        "test/package_test.py",
        "test/plugins_test.py",
        "test/result_test.py",
    ],
    include = ["test/**/*.py"],
)

exports_files(PY_SRCS + PY_TESTS)

py_library(
    name = "core",
    srcs = PY_SRCS,
    imports = ["."],
    deps = [
        "@pip//dacite",
        "@pip//loguru",
        "@pip//pluggy",
    ],
)

iree_py_test(
    name = "config_test",
    size = "small",
    srcs = ["test/config_test.py"],
    main = "test/config_test.py",
    deps = [":core"],
)

iree_py_test(
    name = "log_config_test",
    size = "small",
    srcs = ["test/log_config_test.py"],
    main = "test/log_config_test.py",
    deps = [":core"],
)

iree_py_test(
    name = "plugins_test",
    size = "small",
    srcs = ["test/plugins_test.py"],
    main = "test/plugins_test.py",
    deps = [":core"],
)

iree_py_test(
    name = "result_test",
    size = "small",
    srcs = ["test/result_test.py"],
    main = "test/result_test.py",
    deps = [":core"],
)

iree_py_test(
    name = "package_test",
    size = "small",
    srcs = ["test/package_test.py"],
    main = "test/package_test.py",
    deps = [":core"],
)

# bazel_to_cmake does not convert iree_py_test, so each test is mirrored here
# for CTest. The tests are registered only if the dependencies in
# pyproject.toml are installed, so that builds that use no Python need not
# install them.
iree_cmake_extra_content(
    content = """
if(IREE_BUILD_TESTS)
  execute_process(
    COMMAND
      "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_SOURCE_DIR}/check_requirements.py"
    RESULT_VARIABLE _IREE_CORE_REQUIREMENTS_RESULT
    ERROR_VARIABLE _IREE_CORE_REQUIREMENTS_ERROR
    OUTPUT_QUIET
    ERROR_STRIP_TRAILING_WHITESPACE
  )
  if(_IREE_CORE_REQUIREMENTS_RESULT EQUAL 0)
    iree_local_py_test(
      NAME
        config_test
      SRC
        "test/config_test.py"
      PACKAGE_DIRS
        "${CMAKE_CURRENT_SOURCE_DIR}"
    )

    iree_local_py_test(
      NAME
        log_config_test
      SRC
        "test/log_config_test.py"
      PACKAGE_DIRS
        "${CMAKE_CURRENT_SOURCE_DIR}"
    )

    iree_local_py_test(
      NAME
        plugins_test
      SRC
        "test/plugins_test.py"
      PACKAGE_DIRS
        "${CMAKE_CURRENT_SOURCE_DIR}"
    )

    iree_local_py_test(
      NAME
        result_test
      SRC
        "test/result_test.py"
      PACKAGE_DIRS
        "${CMAKE_CURRENT_SOURCE_DIR}"
    )

    iree_local_py_test(
      NAME
        package_test
      SRC
        "test/package_test.py"
      PACKAGE_DIRS
        "${CMAKE_CURRENT_SOURCE_DIR}"
    )
  else()
    message(STATUS "Not adding the iree.core tests: ${_IREE_CORE_REQUIREMENTS_ERROR}")
  endif()
endif()
""",
    inline = True,
)
